# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/
*.dmg

# Virtual environments
venv/
.venv/
env/
.env/

# Environment variables
.env
.env.local

# LocalLens runtime data (never commit user data)
mcp_license.json
mcp_onboarded.json
port.txt
local_api_token.txt

# IDE / AI agent local settings
.vscode/
.idea/
*.swp
*.swo

# .claude/ is tracked on purpose — it carries the release agent, which has to
# travel with the repo. Only the per-machine permission allowlist stays local.
.claude/settings.local.json

# macOS
.DS_Store
**/.DS_Store

# Test / debugging artifacts
.pytest_cache/
.coverage
htmlcov/
test_env*.py

# Dev-only documentation (not shipped)
.-.-/
for dev/
for LLM's/

# Internal planning, business and marketing docs. This repo is public; these
# stay on the owner's machine. Nothing in tests, CI, the build or the release
# pipeline reads them (they are only mentioned in comments). Public docs that
# users need stay tracked: README, LICENSE.md, NOTICE.md, AGENTS.md,
# docs/INSTRUCTIONS.md, docs/claude_desktop_config.example.json, release_notes/.
docs/superpowers/
docs/TESTING.md
docs/PRICING.md
docs/LAUNCH_CHECKLIST.md
docs/RESTORING_PAID_MODE.md
docs/LICENSE_PLANS_SPEC.md
marketing/
Preview/
.superpowers/

# Build outputs that land outside build/ and dist/ (makensis writes to the root)
locallens-agent-installer.exe
*-setup.exe
*.log

# Tool caches
.mypy_cache/
.ruff_cache/
node_modules/

# Windows
Thumbs.db
desktop.ini

# Web development 
locallensmcp/

# Vite cache (generated at repo root during dev)
.vite/
package-lock.json
